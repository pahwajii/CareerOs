PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration
MONGO_URI=mongodb://127.0.0.1:27017/jobtracker

# JWT configuration
JWT_SECRET=yoursecretkeyforjwtverificationchangeinproduction
JWT_EXPIRES_IN=7d

# AI gateway configuration
# Option A: OmniRoute local gateway
# Start OmniRoute, then use the local OpenAI-compatible endpoint below.
# OMNIROUTE_API_KEY is optional for zero-config local mode; set it if you create an endpoint key in OmniRoute.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto
OMNIROUTE_API_KEY=

# Option B: ForgeAI gateway
FORGE_API_KEY=your_forge_api_key_here
FORGE_BASE_URL=https://forge-gateway-api.fly.dev/v1
FORGE_MODEL=deepseek-r1

# Optional fallback if the primary AI gateway fails
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
